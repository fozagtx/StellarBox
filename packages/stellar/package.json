    "prove:testnet": "node --env-file=../../.env --import tsx ../../scripts/prove-caps.ts"
  },
  "dependencies": {
    "@openzeppelin/relayer-plugin-channels": "0.21.0",
    "@stellar/stellar-sdk": "16.3.1",
    "@x402/stellar": "2.28.0",
    "smart-account-kit": "0.8.0",
    "smart-account-kit-bindings": "0.4.0"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "vitest": "^3.1.2"
  }
}
