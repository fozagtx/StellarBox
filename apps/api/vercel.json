{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm --filter @stellabox/db db:migrate && pnpm build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 120,
      "includeFiles": "dist/vercel.mjs"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
