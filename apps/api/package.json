{
  "name": "@stellabox/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "DATABASE_URL=${DATABASE_URL:-postgres://stellabox:stellabox@127.0.0.1:5433/stellabox} pnpm --filter @stellabox/db db:migrate && DATABASE_URL=${DATABASE_URL:-postgres://stellabox:stellabox@127.0.0.1:5433/stellabox} vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@simplewebauthn/server": "^14.0.3",
    "@stellabox/db": "workspace:*",
    "@stellabox/signer": "workspace:*",
    "@stellabox/stellar": "workspace:*",
    "@stellar/stellar-sdk": "16.3.1",
    "drizzle-orm": "^0.45.4",
    "@x402/core": "2.28.0",
    "@x402/stellar": "2.28.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.12",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "smart-account-kit": "0.8.0",
    "smart-account-kit-bindings": "0.4.0",
    "vitest": "^3.1.2"
  }
}
